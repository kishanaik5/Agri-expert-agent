# Neo4j Settings (Local or Neo4j AuraDB)
NEO4J_URI=neo4j+s://<instance_id>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your_neo4j_password>

# RabbitMQ Settings (Local or CloudAMQP)
CLOUDAMQP_URL=amqps://<username>:<password>@<host>/<vhost>
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=agri_user
RABBITMQ_PASSWORD=agri_pass123

# Server Settings
PORT=8000
API_HOST=0.0.0.0
